{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Vite builds the SPA into dist/; tsc only typechecks and emits declarations elsewhere.
    "outDir": "out-tsc/lib",
    "tsBuildInfoFile": "out-tsc/lib/tsconfig.lib.tsbuildinfo",
    "rootDir": "src",
    "target": "ES2020",
    "useDefineForClassFields": true,
    // ES2022 for Array.prototype.at: it used to come in through the test files' vitest types.
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["@cloudflare/workers-types"],
    "isolatedModules": true,
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"]
}
