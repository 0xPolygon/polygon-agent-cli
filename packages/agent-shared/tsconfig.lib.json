{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Never built to dist/: consumers' bundlers read src/ directly, so tsc only typechecks.
    "outDir": "out-tsc/lib",
    "tsBuildInfoFile": "out-tsc/lib/tsconfig.lib.tsbuildinfo",
    "rootDir": "src"
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts"]
}
